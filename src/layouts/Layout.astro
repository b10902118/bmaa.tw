---
import Header from "../components/Header.astro";
import Footer from "../components/Footer";
import PageContainer from "../components/PageContainer";
import "../index.css";

interface Props {
  title?: string;
}

const { title = "臺灣身心中軸覺察發展中心" } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/assets/image/icons/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <PageContainer>
      <slot />
    </PageContainer>
    <Footer />
  </body>
</html>
